# URL used by the browser. It is embedded into the Next.js bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Dev only: Quick Tunnel (*.trycloudflare.com) is already allowed.
# For a named tunnel, list hostnames without scheme/port, separated by commas.
DEV_ALLOWED_ORIGINS=
# Optional dev API destination reachable from the FE server.
# Direct npm dev defaults to NEXT_PUBLIC_API_URL; Compose uses the host gateway.
# API_PROXY_TARGET=http://localhost:3001/api/v1

# Cross-platform browser URLs. These are embedded at build time and should be
# identical for the Marketplace, Provider, and Admin images in one environment.
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:3000
NEXT_PUBLIC_PROVIDER_URL=http://localhost:3003
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# Runtime platform for local single-server development. Docker Compose sets
# WEB_PLATFORM separately for all three services.
WEB_PLATFORM=marketplace
