# URL used by the browser. It is embedded into the Next.js bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:50001/api/v1

# Cross-platform browser URLs. These are embedded at build time and should be
# identical for the Marketplace, Provider, and Admin images in one environment.
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:3000
NEXT_PUBLIC_PROVIDER_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# Runtime platform. Use marketplace, provider, or admin.
WEB_PLATFORM=marketplace

# Host port exposed by Docker Compose.
WEB_PORT=3000
